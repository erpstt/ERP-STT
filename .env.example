# Configure estos valores al conectar Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
PORT=3000
# URL pública usada en enlaces de notificaciones.
GENTIA_APP_URL=http://localhost:3000
# NEXO_APP_URL continúa admitida como alias temporal para instalaciones existentes.

# BCCR SDDE: token de Mi Perfil en https://sdd.bccr.fi.cr
BCCR_TOKEN=
# Necesaria para guardar las consultas automaticas en Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# Solo para aplicar y verificar migraciones desde scripts de administracion.
SUPABASE_DB_PASSWORD=
# Opcionales: SUPABASE_DB_HOST, SUPABASE_DB_PORT, SUPABASE_DB_USER.
# Por defecto los tests de auditoria usan el pooler us-east-1:6543.
