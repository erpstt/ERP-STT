# Configure estos valores al conectar Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Tiempo máximo por solicitud antes de liberar la conexión (milisegundos).
SUPABASE_REQUEST_TIMEOUT_MS=20000
# Protege PostgREST/RPC de picos: las solicitudes adicionales esperan en una
# cola cancelable por proceso, sin consumir una conexión aguas arriba.
SUPABASE_MAX_CONCURRENCY=24
# Caché en memoria de validaciones positivas de sesión/dispositivo. Un valor
# distinto de cero se limita al rango seguro de 10.000 a 30.000 ms; 0 desactiva.
# En ese intervalo, una revocación hecha en otra réplica puede tardar en aplicarse.
AUTH_REQUEST_ACCESS_CACHE_TTL_MS=30000
# Límite por proceso para evitar crecimiento de memoria con sesiones distintas.
AUTH_REQUEST_ACCESS_CACHE_MAX_ENTRIES=5000
# Caché de catálogos de lectura: 0 desactiva; cualquier otro valor se limita a
# 1.000-300.000 ms. Las claves conservan únicamente hashes del alcance.
READ_CACHE_DEFAULT_TTL_MS=30000
READ_CACHE_MAX_ENTRIES=2000
# Cardinalidad y muestra móvil de telemetría por proceso.
PERFORMANCE_METRICS_MAX_ROUTES=128
PERFORMANCE_METRICS_SAMPLE_SIZE=256
# Evita que varias exportaciones PDF agoten la memoria del servidor (1 a 4).
PDF_RENDER_CONCURRENCY=2
PORT=3000
# Cloudflare Turnstile. Cree el widget en Cloudflare y no exponga la clave secreta.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Dominios separados por coma, por ejemplo: erp.empresa.com
TURNSTILE_ALLOWED_HOSTNAMES=
# Active solo si el servidor recibe tráfico exclusivamente a través de Cloudflare.
TRUST_CLOUDFLARE_PROXY=false
# URL pública usada en enlaces de notificaciones y recuperación de contraseña.
# Registre esta misma URL como Site URL y Redirect URL en Supabase Auth.
GENTIA_APP_URL=https://erp-stt-production.up.railway.app
# Mantenga ambos valores idénticos: aprobaciones y calendarios también generan enlaces.
APP_BASE_URL=https://erp-stt-production.up.railway.app
# NEXO_APP_URL continúa admitida como alias temporal para instalaciones existentes.

# Correo transaccional de GENTIA. Supabase Auth debe usar el mismo proveedor SMTP
# para el flujo público "¿Olvidaste tu contraseña?" en producción.
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=GENTIA <no-reply@example.com>
SMTP_USER=
SMTP_PASSWORD=

# Frecuencia de consulta de la cola de reportes programados (5.000 a 300.000 ms).
# Al encontrar trabajo, la cola se vacía inmediatamente sin esperar este intervalo.
SCHEDULED_REPORT_POLL_MS=30000
# Frecuencia de consulta de las colas de correo cuando no hay trabajo (5.000 a 300.000 ms).
# Si hay elementos pendientes, se continúan procesando cada 250 ms hasta vaciar la cola.
NOTIFICATION_QUEUE_POLL_MS=30000

# BCCR SDDE: token de Mi Perfil en https://sdd.bccr.fi.cr
BCCR_TOKEN=
# Necesaria para automatizaciones y para custodiar los estados de recuperación.
# Nunca exponga esta llave en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Token personal o limitado de Supabase Management API. Solo se requiere para
# scripts administrativos; concédale auth_config_read y auth_config_write.
SUPABASE_ACCESS_TOKEN=

# Solo para aplicar y verificar migraciones desde scripts de administracion.
SUPABASE_DB_PASSWORD=
# Opcionales: SUPABASE_DB_HOST, SUPABASE_DB_PORT, SUPABASE_DB_USER.
# Por defecto los tests de auditoria usan el pooler us-east-1:6543.
