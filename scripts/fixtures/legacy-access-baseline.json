{
  "roles": [
    {
      "role_id": 1,
      "role_name": "Administrador",
      "description": "Acceso administrativo global a todas las empresas y configuraciones"
    },
    {
      "role_id": 2,
      "role_name": "Contador Regional",
      "description": "Supervisión técnica y aprobación de estados financieros y cierres."
    },
    {
      "role_id": 3,
      "role_name": "Encargado de Cuentas por Cobrar",
      "description": "Emisión de comprobantes de venta y cobros."
    },
    {
      "role_id": 4,
      "role_name": "Encargado de Cuentas por Pagar",
      "description": "Registro de compras, facturas de proveedores y pagos."
    },
    {
      "role_id": 5,
      "role_name": "Gerente Financiero / CFO",
      "description": "Supervisión de consolidación multi-empresa (NIIF 10), autorización de flujos de caja y aprobación final de workflows de alto valor."
    },
    {
      "role_id": 6,
      "role_name": "Encargado de Tesorería",
      "description": "Ejecución final de desembolsos aprobados, conciliación bancaria, emisión de cheques y transferencias entre cuentas (TRF_BAN)."
    },
    {
      "role_id": 7,
      "role_name": "Encargado de Compras",
      "description": "Gestión de proveedores, emisión y seguimiento de Órdenes de Compra (ORD_COM) y recepción de insumos."
    },
    {
      "role_id": 8,
      "role_name": "Encargado de Ventas",
      "description": "Creación de cotizaciones, procesamiento de pedidos de venta (PED_VEN) y verificación de límites de crédito/descuentos."
    },
    {
      "role_id": 9,
      "role_name": "Encargado de Inventario / Bodega",
      "description": "Control de Kardex, recepciones de inventario, traslados entre bodegas/sedes y toma de inventarios físicos."
    },
    {
      "role_id": 10,
      "role_name": "Encargado de Activos Fijos",
      "description": "Gestión del catálogo de bienes (NIC 16), procesamiento de la bandeja de propuestas de capitalización y corridas de depreciación."
    },
    {
      "role_id": 11,
      "role_name": "Gerente de Subsidiaria",
      "description": "Administración y acceso operativo limitado exclusivamente a la sucursal o subsidiaria asignada (sin visibilidad de la Holding)."
    },
    {
      "role_id": 12,
      "role_name": "Contador de Subsidiaria",
      "description": "Responsable del ciclo contable exclusivo de una filial asignada. Contabiliza asientos, genera declaraciones locales y ejecuta el cierre de mes local."
    },
    {
      "role_id": 13,
      "role_name": "Gestor de Unidad de Proyectos",
      "description": "Responsable de la facturación por hitos/avances, y análisis de rentabilidad (Estado de Resultados de Ingresos vs Costos) por cliente y proyecto."
    }
  ],
